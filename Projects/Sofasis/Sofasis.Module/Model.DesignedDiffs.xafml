    <ListView Id="StokTransferi_ListView" ClassName="Sofasis.Module.BusinessObjects.StokTransferi" Caption="Depo Transferi" IsNewNode="True">
      <Columns IsNewNode="True">
        <ColumnInfo Id="FisNo" PropertyName="FisNo" Index="0" IsNewNode="True" />
        <ColumnInfo Id="FisTarihi" PropertyName="FisTarihi" Index="1" IsNewNode="True" />
        <ColumnInfo Id="StokTanim" PropertyName="StokTanim" Index="2" IsNewNode="True" />
        <ColumnInfo Id="KaynakDepo" PropertyName="KaynakDepo" Index="3" IsNewNode="True" />
        <ColumnInfo Id="HedefDepo" PropertyName="HedefDepo" Index="4" IsNewNode="True" />
        <ColumnInfo Id="Miktar" PropertyName="Miktar" Index="5" IsNewNode="True" />
      </Columns>
    </ListView>
    <ListView Id="StokBakiye_ListView" ClassName="Sofasis.Module.BusinessObjects.StokBakiye" Caption="Stok Bakiye" AllowNew="False" AllowDelete="False" AllowEdit="False" IsNewNode="True">
      <Columns IsNewNode="True">
        <ColumnInfo Id="StokTanim" PropertyName="StokTanim" Index="0" IsNewNode="True" />
        <ColumnInfo Id="DepoTanim" PropertyName="DepoTanim" Index="1" IsNewNode="True" />
        <ColumnInfo Id="Miktar" PropertyName="Miktar" Index="2" IsNewNode="True" />
