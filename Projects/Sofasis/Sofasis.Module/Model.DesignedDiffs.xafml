        <ColumnInfo Id="ToplamDeger" PropertyName="ToplamDeger" Index="4" IsNewNode="True" />
      </Columns>
    </ListView>

    <!-- Gösterge Paneli (Dashboard) — özel KPI kart + grafik bileşeni. Liste-tabanlı ilk sürüm
         (4 ayrı ListView kartı) kullanıcı isteğiyle bu özel Blazor bileşenine (KpiDashboardComponent)
         çevrildi; kart/grafik verileri bileşenin kendi içinde ObjectSpace üzerinden hesaplanır,
         ayrı ListView tanımına ihtiyaç yok. -->
    <DashboardView Id="AnaDashboard_DashboardView" Caption="Gösterge Paneli" IsNewNode="True">
      <Items IsNewNode="True">
        <ControlDetailItem Id="KpiDashboardItem" ControlTypeName="Sofasis.Blazor.Server.Editors.KpiDashboardComponent" IsNewNode="True" />
      </Items>
      <Layout IsNewNode="True">
        <LayoutGroup Id="Main" RelativeSize="100" IsNewNode="True">
          <LayoutItem Id="KpiDashboardItem" ViewItem="KpiDashboardItem" Index="0" RelativeSize="100" IsNewNode="True" />
        </LayoutGroup>
      </Layout>
    </DashboardView>
  </Views>
</Application>