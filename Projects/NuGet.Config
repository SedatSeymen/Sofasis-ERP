<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    DevExpress paketleri (DevExpress.*) HER ZAMAN yerel offline beslemeden
    ("DevExpress 26.1 Local", DevExpress kurulumunun makineye ekledigi
    kaynak) gelir; nuget.org'da bulunmadiklari icin oraya sorgu bile
    atilmaz. Diger tum paketler (CsvHelper, Microsoft.*, vb.) nuget.org'dan
    gelmeye devam eder. Kaynak adlari makine genelindeki NuGet.Config'ten
    (DevExpress kurulumu tarafindan eklenir) miras alinir; burada yeniden
    tanimlanmaz, sadece eslestirme (mapping) yapilir.
  -->
  <packageSourceMapping>
    <packageSource key="DevExpress 26.1 Local">
      <package pattern="DevExpress.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
