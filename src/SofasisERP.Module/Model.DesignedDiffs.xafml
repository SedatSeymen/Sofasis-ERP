    <!-- "Tüm X Hareketleri" ekranları — kullanıcı isteği (2026-08-21): her modülün Hareketler
         grubunun en altında, o hesap türüne ait TÜM fiş türlerini (Açılış/Tahsilat/Ödeme/Virman)
         tek listede gösteren, filtrelenmemiş bir özet ekranı. Fiş Türü'ne göre filtrelenmiyor
         (yalnızca HesapTuru'na göre) — bu yüzden StokHareketleriM_ListView'daki "Tüm Stok
         Hareketleri" deseniyle aynı: DetailViewID override YOK (genel KasaCariBankaHareketleri_
         DetailView'e düşer), New/Delete kısıtlanmıyor — çift tıklayınca detay ekranı açılır. -->
    <ListView Id="KasaCariBankaHareketleri_CariTumHareketlerListView" ClassName="SofasisERP.Module.BusinessObjects.KasaCariBankaHareketleri" Criteria="[KaynakHesap.HesapTuru] = 'Cari' Or [KarsiHesap.HesapTuru] = 'Cari'" Caption="Tüm Cari Hareketleri" DetailViewID="KasaCariBankaHareketleri_DetailView" IsNewNode="True">
