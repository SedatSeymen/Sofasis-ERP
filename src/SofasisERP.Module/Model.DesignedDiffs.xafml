    <ListView Id="StokTanim_ListView" Criteria="[StokHizmetMasrafTipi] = 'Stok'">
      <Columns IsNewNode="True">
        <ColumnInfo Id="StokKodu" PropertyName="StokKodu" Index="0" IsNewNode="True" />
        <ColumnInfo Id="StokAdi" PropertyName="StokAdi" Index="1" IsNewNode="True" />
        <ColumnInfo Id="SatilabilirMi" PropertyName="SatilabilirMi" Index="2" IsNewNode="True" />
        <ColumnInfo Id="StokTipi" PropertyName="StokTipi" Index="3" IsNewNode="True" />
        <ColumnInfo Id="StokGrubu" PropertyName="StokGrubu" Index="4" IsNewNode="True" />
        <ColumnInfo Id="StokAltGrubu" PropertyName="StokAltGrubu" Index="5" IsNewNode="True" />
        <ColumnInfo Id="Model" PropertyName="Model" Index="6" IsNewNode="True" />
        <ColumnInfo Id="BirimTanim" PropertyName="BirimTanim" Index="7" IsNewNode="True" />
        <ColumnInfo Id="Resim" PropertyName="Resim" Index="8" IsNewNode="True" />
      </Columns>
    </ListView>
    <ListView Id="DovizTanim_ListView">
      <Columns IsNewNode="True">
        <ColumnInfo Id="DovizKodu" PropertyName="DovizKodu" Index="0" IsNewNode="True" />
