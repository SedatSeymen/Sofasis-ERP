            <LayoutGroup Id="DovizGunlukKurM" RelativeSize="100" Removed="True">
              <LayoutItem Id="KurAciklama" Removed="True" />
              <LayoutItem Id="KurTarihi" Removed="True" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <DetailView Id="UlkeTanim_DetailView" IsNewNode="True">
      <Layout IsNewNode="True">
        <LayoutGroup Id="Main" RelativeSize="100" IsNewNode="True">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100" IsNewNode="True">
            <TabbedGroup Id="Tabs" CaptionLocation="Top" Index="0" RelativeSize="100" IsNewNode="True">
              <LayoutGroup Id="Genel" Caption="Genel" Direction="Vertical" Index="0" RelativeSize="100" IsNewNode="True">
                <LayoutItem Id="UlkeKodu" ViewItem="UlkeKodu" Index="0" RelativeSize="25" IsNewNode="True" />
                <LayoutItem Id="UlkeAdi" ViewItem="UlkeAdi" Index="1" RelativeSize="25" IsNewNode="True" />
                <LayoutItem Id="UlkeTelefonKodu" ViewItem="UlkeTelefonKodu" Index="2" RelativeSize="25" IsNewNode="True" />
                <LayoutItem Id="IsVarsayilan" ViewItem="IsVarsayilan" Index="3" RelativeSize="25" IsNewNode="True" />
              </LayoutGroup>
              <LayoutGroup Id="OzelKodlar" Caption="Özel Kodlar &amp; Açıklama" Direction="Vertical" Index="1" RelativeSize="100" IsNewNode="True">
                <LayoutGroup Id="UlkeTanim_Row2" ShowCaption="False" Direction="Horizontal" Index="0" RelativeSize="20" IsNewNode="True">
                  <LayoutItem Id="CustomCode1" ViewItem="CustomCode1" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="CustomCode2" ViewItem="CustomCode2" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
                <LayoutItem Id="Description" ViewItem="Description" Index="1" RelativeSize="80" IsNewNode="True" />
              </LayoutGroup>
              <LayoutGroup Id="Denetim" Caption="Denetim" Direction="Horizontal" Index="2" RelativeSize="100" IsNewNode="True">
                <LayoutGroup Id="UlkeTanim_Denetim_col1" ShowCaption="False" Index="0" RelativeSize="50" IsNewNode="True">
                  <LayoutItem Id="CreatedBy" ViewItem="CreatedBy" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="ModifiedBy" ViewItem="ModifiedBy" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
                <LayoutGroup Id="UlkeTanim_Denetim_col2" ShowCaption="False" Index="1" RelativeSize="50" IsNewNode="True">
                  <LayoutItem Id="CreatedDate" ViewItem="CreatedDate" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="ModifiedDate" ViewItem="ModifiedDate" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
              </LayoutGroup>
            </TabbedGroup>
            <LayoutGroup Id="BaseClassWithAuditAndDescription" RelativeSize="100" Removed="True">
              <LayoutItem Id="CustomCode1" Removed="True" />
              <LayoutItem Id="CustomCode2" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="BaseClassWithAudit" RelativeSize="100" Removed="True">
              <LayoutItem Id="CreatedBy" Removed="True" />
              <LayoutItem Id="ModifiedBy" Removed="True" />
              <LayoutItem Id="CreatedDate" Removed="True" />
              <LayoutItem Id="ModifiedDate" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="SizeableEditors" Removed="True">
              <LayoutItem Id="Description" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="UlkeTanim" RelativeSize="100" Removed="True">
              <LayoutItem Id="UlkeKodu" Removed="True" />
              <LayoutItem Id="UlkeAdi" Removed="True" />
              <LayoutItem Id="UlkeTelefonKodu" Removed="True" />
              <LayoutItem Id="IsVarsayilan" Removed="True" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <!-- ListView kolon sırası: Kod alanı olan sınıflarda Kod, Ad ile başlar (kural #1). -->
    <ListView Id="ModelTanim_ListView">
      <Columns IsNewNode="True">
        <ColumnInfo Id="ModelAdi" PropertyName="ModelAdi" Index="0" IsNewNode="True" />
        <ColumnInfo Id="Resim" PropertyName="Resim" Index="1" IsNewNode="True" />
      </Columns>
    </ListView>
    <ListView Id="StokTipiTanim_ListView">
      <Columns IsNewNode="True">
        <ColumnInfo Id="StokTipiKodu" PropertyName="StokTipiKodu" Index="0" IsNewNode="True" />
        <ColumnInfo Id="StokTipiAdi" PropertyName="StokTipiAdi" Index="1" IsNewNode="True" />
        <ColumnInfo Id="MamulMu" PropertyName="MamulMu" Index="2" IsNewNode="True" />
