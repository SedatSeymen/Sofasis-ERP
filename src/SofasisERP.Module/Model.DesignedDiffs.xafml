  <Views>
    <!-- Gösterge Paneli (Dashboard) — özel KPI kart bileşeni (KpiDashboardComponent),
         eski SofasisERP'deki desenin aynısı: ControlDetailItem ile Blazor bileşenini
         tam-genişlik bir DashboardView içine gömer, ayrı ListView/veri sorgusu gerekmez
         (veri bileşenin kendi içinde ObjectSpace üzerinden hesaplanır). -->
    <DashboardView Id="AnaDashboard_DashboardView" Caption="Gösterge Paneli" IsNewNode="True">
      <Items IsNewNode="True">
        <ControlDetailItem Id="KpiDashboardItem" ControlTypeName="SofasisERP.Blazor.Server.Editors.KpiDashboardComponent" IsNewNode="True" />
      </Items>
      <Layout IsNewNode="True">
        <LayoutGroup Id="Main" RelativeSize="100" IsNewNode="True">
          <LayoutItem Id="KpiDashboardItem" ViewItem="KpiDashboardItem" Index="0" RelativeSize="100" IsNewNode="True" />
        </LayoutGroup>
      </Layout>
      <!-- "Gösterge tablosu düzenlemek" (OrganizeDashboard) — sürükle-bırak dashboard
           tasarımcısı, bizim sabit KpiDashboardComponent konteynerimizde anlamsız,
           kullanıcı isteğiyle (2026-08-21) kaldırıldı. ActionDesign/Actions altında
           Active="False" DENENDİ, ETKİSİZ kaldı (Active bir Model property değil,
           runtime BoolList) — doğru mekanizma View'a özel HiddenActions node'u. -->
      <HiddenActions IsNewNode="True">
        <ActionLink Id="OrganizeDashboard" IsNewNode="True" />
      </HiddenActions>
    </DashboardView>
