<?xml version="1.0" ?>
<Application Title="SofasisERP">
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <Views>
    <!-- Denetim (audit) sekmesi her DetailView'da EN SONDA — eski projeden aynen taşınan
         kanıtlanmış desen (bkz. Brain/Mimari/00_DetailView_ve_Servis_Konvansiyonlari.md).
         [DetailViewLayoutAttribute] Blazor'da çalışmadığı için elle Layout XML'i yazılır.

         Standart kurallar (2026-08-17, kullanıcı kararı — tüm ekranlarda uygulanır):
         1) Kod alanı olan sınıflarda alan/kolon sırası HER ZAMAN Kod, Ad ile başlar (FK'ler sonra).
         2) Sınıfın kendi alan sayısı <=5 ise DetailView'ın Genel sekmesi TEK KOLON (satır başına
            tek alan) düzenlenir; >5 ise çift/çoklu sütun gruplama serbesttir.
         3) Resim alanı olan sınıflarda Resim, Genel ile Özel Kodlar & Açıklama arasında AYRI
            bir sekmede gösterilir; Genel sekmesinin içine gömülmez. -->
    <DetailView Id="ModelTanim_DetailView" IsNewNode="True">
      <Layout IsNewNode="True">
        <LayoutGroup Id="Main" RelativeSize="100" IsNewNode="True">
          <LayoutGroup Id="SimpleEditors" RelativeSize="100" IsNewNode="True">
            <TabbedGroup Id="Tabs" CaptionLocation="Top" Index="0" RelativeSize="100" IsNewNode="True">
              <LayoutGroup Id="Genel" Caption="Genel" Direction="Vertical" Index="0" RelativeSize="100" IsNewNode="True">
                <LayoutItem Id="ModelAdi" ViewItem="ModelAdi" Index="0" RelativeSize="50" IsNewNode="True" />
                <LayoutItem Id="ModelAdiIngilizce" ViewItem="ModelAdiIngilizce" Index="1" RelativeSize="50" IsNewNode="True" />
              </LayoutGroup>
              <LayoutGroup Id="ResimGrubu" Caption="Resim" Direction="Vertical" Index="1" RelativeSize="100" IsNewNode="True">
                <LayoutItem Id="Resim" ViewItem="Resim" Index="0" RelativeSize="100" IsNewNode="True" />
              </LayoutGroup>
              <LayoutGroup Id="OzelKodlar" Caption="Özel Kodlar &amp; Açıklama" Direction="Vertical" Index="2" RelativeSize="100" IsNewNode="True">
                <LayoutGroup Id="ModelTanim_Row2" ShowCaption="False" Direction="Horizontal" Index="0" RelativeSize="20" IsNewNode="True">
                  <LayoutItem Id="CustomCode1" ViewItem="CustomCode1" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="CustomCode2" ViewItem="CustomCode2" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
                <LayoutItem Id="Description" ViewItem="Description" Index="1" RelativeSize="80" IsNewNode="True" />
              </LayoutGroup>
              <LayoutGroup Id="Denetim" Caption="Denetim" Direction="Horizontal" Index="3" RelativeSize="100" IsNewNode="True">
                <LayoutGroup Id="ModelTanim_Denetim_col1" ShowCaption="False" Index="0" RelativeSize="50" IsNewNode="True">
                  <LayoutItem Id="CreatedBy" ViewItem="CreatedBy" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="ModifiedBy" ViewItem="ModifiedBy" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
                <LayoutGroup Id="ModelTanim_Denetim_col2" ShowCaption="False" Index="1" RelativeSize="50" IsNewNode="True">
                  <LayoutItem Id="CreatedDate" ViewItem="CreatedDate" Index="0" RelativeSize="50" IsNewNode="True" />
                  <LayoutItem Id="ModifiedDate" ViewItem="ModifiedDate" Index="1" RelativeSize="50" IsNewNode="True" />
                </LayoutGroup>
              </LayoutGroup>
            </TabbedGroup>
            <LayoutGroup Id="BaseClassWithAuditAndDescription" RelativeSize="100" Removed="True">
              <LayoutItem Id="CustomCode1" Removed="True" />
              <LayoutItem Id="CustomCode2" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="BaseClassWithAudit" RelativeSize="100" Removed="True">
              <LayoutItem Id="CreatedBy" Removed="True" />
              <LayoutItem Id="ModifiedBy" Removed="True" />
              <LayoutItem Id="CreatedDate" Removed="True" />
              <LayoutItem Id="ModifiedDate" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="SizeableEditors" Removed="True">
              <LayoutItem Id="Description" Removed="True" />
            </LayoutGroup>
            <LayoutGroup Id="ModelTanim" RelativeSize="100" Removed="True">
              <LayoutItem Id="ModelAdi" Removed="True" />
              <LayoutItem Id="ModelAdiIngilizce" Removed="True" />
              <LayoutItem Id="Resim" Removed="True" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
