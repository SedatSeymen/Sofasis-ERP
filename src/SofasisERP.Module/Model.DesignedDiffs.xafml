        <ColumnInfo Id="IsVarsayilan" PropertyName="IsVarsayilan" Index="3" IsNewNode="True" />
      </Columns>
    </ListView>
  </Views>
  <NavigationItems NavigationStyle="Accordion">
    <Items>
      <Item Id="StokYonetimi" Caption="Stok Yönetimi" ImageName="BO_Resources" Index="0" IsNewNode="True">
        <Items>
          <Item Id="StokYonetimi_Tanimlar" Caption="Tanımlar" Index="0" IsNewNode="True">
            <Items>
              <Item Id="ModelTanim_ListView" ViewId="ModelTanim_ListView" Index="0" IsNewNode="True" />
              <Item Id="StokTipiTanim_ListView" ViewId="StokTipiTanim_ListView" Index="1" IsNewNode="True" />
              <Item Id="StokGrupTanim_ListView" ViewId="StokGrupTanim_ListView" Index="2" IsNewNode="True" />
              <!-- StokAltGrupTanim BİLEREK yok — saf Detail, StokGrupTanim'in Aggregated koleksiyonundan düzenlenir. -->
              <Item Id="StokTanim_ListView" ViewId="StokTanim_ListView" Index="3" IsNewNode="True" />
              <Item Id="HizmetTanim_ListView" ViewId="HizmetTanim_ListView" Index="4" IsNewNode="True" />
              <Item Id="MasrafTanim_ListView" ViewId="MasrafTanim_ListView" Index="5" IsNewNode="True" />
              <Item Id="StokParametre_ListView" ViewId="StokParametre_ListView" Index="6" IsNewNode="True" />
            </Items>
          </Item>
          <!-- Hareketler: Faz 2'de StokHareketi/Fiş eklenince doldurulacak — grup şimdiden
               açılıyor ki ileride yeni bir üst-seviye grup icat edilmesin. -->
          <Item Id="StokYonetimi_Hareketler" Caption="Hareketler" Index="1" IsNewNode="True">
            <Items>
            </Items>
          </Item>
        </Items>
      </Item>
      <!-- Birim/Döviz/KDV/Kur gibi paylaşılan referans verileri — eski projedeki gibi tek
           düz "Genel Tanımlar" grubu, herhangi bir modüle özel değil. -->
      <Item Id="GenelTanimlar" Caption="Genel Tanımlar" ImageName="BO_Unit" Index="1" IsNewNode="True">
        <Items>
          <Item Id="UlkeTanim_ListView" ViewId="UlkeTanim_ListView" Index="0" IsNewNode="True" />
          <!-- SehirTanim ve IlceTanim BİLEREK yok — saf Detail, sırasıyla UlkeTanim ve
               SehirTanim'in Aggregated koleksiyonlarından düzenlenir. -->
          <Item Id="BirimTanim_ListView" ViewId="BirimTanim_ListView" Index="2" IsNewNode="True" />
          <Item Id="DovizTanim_ListView" ViewId="DovizTanim_ListView" Index="3" IsNewNode="True" />
          <Item Id="KDVTanim_ListView" ViewId="KDVTanim_ListView" Index="4" IsNewNode="True" />
          <Item Id="DovizGunlukKurM_ListView" ViewId="DovizGunlukKurM_ListView" Index="5" IsNewNode="True" />
          <!-- DovizGunlukKurD BİLEREK yok — saf Detail, DovizGunlukKurM'in Aggregated koleksiyonundan düzenlenir. -->
          <Item Id="GenelParametre_ListView" ViewId="GenelParametre_ListView" Index="6" IsNewNode="True" />
          <Item Id="FisTuruTanim_ListView" ViewId="FisTuruTanim_ListView" Index="7" IsNewNode="True" />
        </Items>
      </Item>
    </Items>
  </NavigationItems>
</Application>
