        <ColumnInfo Id="FisTuruTanim" PropertyName="FisTuruTanim" Index="2" IsNewNode="True" />
        <ColumnInfo Id="KaynakHesap" PropertyName="KaynakHesap" Index="3" IsNewNode="True" />
        <ColumnInfo Id="KarsiHesap" PropertyName="KarsiHesap" Index="4" IsNewNode="True" />
        <ColumnInfo Id="BorcTutar" PropertyName="BorcTutar" Index="5" IsNewNode="True" />
        <ColumnInfo Id="AlacakTutar" PropertyName="AlacakTutar" Index="6" IsNewNode="True" />
        <ColumnInfo Id="BelgeNo" PropertyName="BelgeNo" Index="7" IsNewNode="True" />
