        <ColumnInfo Id="Sembol" PropertyName="Sembol" Index="2" IsNewNode="True" />
        <ColumnInfo Id="IsVarsayilan" PropertyName="IsVarsayilan" Index="3" IsNewNode="True" />
      </Columns>
    </ListView>
    <ListView Id="UlkeTanim_ListView">
      <Columns IsNewNode="True">
        <ColumnInfo Id="UlkeKodu" PropertyName="UlkeKodu" Index="0" IsNewNode="True" />
