        <PropertyEditor Id="CustomCode1" PropertyName="CustomCode1" IsNewNode="True" />
        <PropertyEditor Id="CustomCode2" PropertyName="CustomCode2" IsNewNode="True" />
        <PropertyEditor Id="Description" PropertyName="Description" IsNewNode="True" />
        <PropertyEditor Id="CreatedBy" PropertyName="CreatedBy" IsNewNode="True" />
        <PropertyEditor Id="ModifiedBy" PropertyName="ModifiedBy" IsNewNode="True" />
