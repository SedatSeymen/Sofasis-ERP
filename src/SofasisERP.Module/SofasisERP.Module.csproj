<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Configurations>Debug;Release;EasyTest</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Model.DesignedDiffs.xafml" />
    <None Remove="Resources\Seed\*.csv" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Model.DesignedDiffs.xafml" />
    <EmbeddedResource Include="Resources\Seed\*.csv" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.CodeAnalysis" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ConditionalAppearance" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Validation" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Dashboards" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Security" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Security.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.Base" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.BaseImpl.Xpo" Version="26.1.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>
</Project>
