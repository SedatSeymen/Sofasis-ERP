{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sofasis.Blazor.Server (Kestrel, Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Projects/Sofasis/Sofasis.Blazor.Server/bin/Debug/net10.0/Sofasis.Blazor.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Projects/Sofasis/Sofasis.Blazor.Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
